---
import { NAV, SITE } from '../consts';
import ThemeToggle from './ThemeToggle';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-20 border-b border-line bg-bg/85 backdrop-blur">
	<nav class="container-page flex h-14 items-center justify-between gap-4 font-mono text-sm">
		<a href="/" class="group flex items-center gap-2 text-fg" aria-label={`${SITE.name}, home`}>
			<span class="inline-block h-2 w-2 rounded-full bg-up shadow-[0_0_8px_var(--c-up)]" aria-hidden="true"></span>
			<span class="group-hover:text-accent"><span class="text-faint">~/</span>{SITE.handle}</span>
		</a>
		<div class="flex items-center gap-1 sm:gap-3">
			<ul class="flex items-center">
				{
					NAV.map(({ href, label }) => (
						<li>
							<a
								href={href}
								aria-current={isActive(href) ? 'page' : undefined}
								class:list={[
									'px-1.5 py-1 transition-colors sm:px-2',
									isActive(href) ? 'text-accent' : 'text-muted hover:text-fg',
								]}
							>
								<span class="hidden text-faint sm:inline">/</span>
								{label}
							</a>
						</li>
					))
				}
			</ul>
			<ThemeToggle client:load />
		</div>
	</nav>
</header>
