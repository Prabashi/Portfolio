---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title?: string;
	description?: string;
	type?: 'website' | 'article';
}

const props = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<BaseHead {...props} />
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-accent focus:px-3 focus:py-1 focus:font-mono focus:text-sm focus:text-bg"
			>Skip to content</a
		>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
