---
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Ticker from '../components/Ticker.astro';
import { LINKS, SITE, STACK } from '../consts';
import Layout from '../layouts/Layout.astro';
import { getPosts, getProjects } from '../lib/content';

const projects = await getProjects();
const featured = (projects.some((p) => p.data.featured) ? projects.filter((p) => p.data.featured) : projects).slice(0, 3);
const posts = (await getPosts()).slice(0, 4);

const profile = [
	['role', SITE.role],
	['experience', `${SITE.yearsInIndustry} yrs · capital markets`],
	['focus', 'trading systems · market data · post-trade'],
	['core', 'C# / .NET · distributed systems'],
	['based', SITE.location],
];
---

<Layout>
	<Ticker />

	<section class="container-page grid gap-10 pt-16 pb-20 md:grid-cols-[1.4fr_1fr] md:items-center md:pt-24">
		<div>
			<p class="font-mono text-sm text-muted">
				<span class="text-up">{SITE.handle}@dev</span>:<span class="text-accent">~</span>$ whoami
			</p>
			<h1 class="mt-4 text-4xl font-semibold tracking-tight text-fg sm:text-5xl">
				{SITE.name}<span class="cursor"></span>
			</h1>
			<p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
				I build the systems behind trading: order flow, market data, and post-trade pipelines that have to be{' '}
				<span class="text-fg">fast, correct, and boring to operate</span>. {SITE.yearsInIndustry} years in capital
				markets tech across GIC, WSO2 and DirectFN, mostly in C# and .NET.
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-3">
				<a href={LINKS.resume} class="btn btn-primary">résumé.pdf <span aria-hidden="true">↓</span></a>
				<a href="/projects" class="btn">view projects <span aria-hidden="true">→</span></a>
			</div>
			<SocialLinks class="mt-6" />
		</div>

		<div class="panel font-mono text-sm">
			<div class="panel-head">
				<span>profile.json</span>
				<span class="flex gap-1.5" aria-hidden="true">
					<span class="h-2 w-2 rounded-full bg-line"></span>
					<span class="h-2 w-2 rounded-full bg-line"></span>
					<span class="h-2 w-2 rounded-full bg-accent"></span>
				</span>
			</div>
			<dl class="divide-y divide-line">
				{
					profile.map(([k, v]) => (
						<div class="grid grid-cols-[6.5rem_1fr] gap-3 px-4 py-2.5">
							<dt class="text-faint">{k}</dt>
							<dd class="text-fg">{v}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="container-page">
		<SectionHeading title="selected work" href="/projects" />
		<div class="grid gap-4 md:grid-cols-3">
			{featured.map((project, i) => <ProjectCard project={project} index={i} />)}
		</div>
	</section>

	<section class="container-page mt-20 grid gap-12 md:grid-cols-[1.6fr_1fr]">
		<div>
			<SectionHeading title="writing" href="/blog" />
			<PostList posts={posts} />
		</div>
		<div>
			<SectionHeading title="stack" />
			<ul class="flex flex-wrap gap-2">
				{STACK.map((s) => <li class="chip !px-2 !py-1 !text-xs">{s}</li>)}
			</ul>
			<p class="mt-6 text-sm text-muted">
				More on how I got here on the <a href="/about" class="link">about page</a>.
			</p>
		</div>
	</section>
</Layout>
