---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found">
	<div class="container-page pt-24 font-mono">
		<p class="text-sm text-down">ERR 404 · ORDER REJECTED</p>
		<h1 class="mt-3 text-3xl font-bold text-fg">No such route.</h1>
		<p class="mt-3 text-muted">The page you asked for isn't on the book.</p>
		<a href="/" class="btn mt-8">← back home</a>
	</div>
</Layout>
