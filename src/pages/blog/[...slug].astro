---
import { type CollectionEntry, render } from 'astro:content';
import Decision from '../../components/Decision.astro';
import Figure from '../../components/Figure.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PlaceholderBadge from '../../components/PlaceholderBadge.astro';
import Layout from '../../layouts/Layout.astro';
import { getPosts, readingMinutes } from '../../lib/content';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		// Posts are sorted newest first.
		props: { post, newer: posts[i - 1], older: posts[i + 1], all: posts },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
	newer?: CollectionEntry<'blog'>;
	older?: CollectionEntry<'blog'>;
	all: CollectionEntry<'blog'>[];
}

const { post, newer, older, all } = Astro.props;
const { title, description, pubDate, updatedDate, tags, series, draft, placeholder } = post.data;
const { Content } = await render(post);
const minutes = readingMinutes(post.body);

const seriesPosts = series
	? all
			.filter((p) => p.data.series === series)
			.sort((a, b) => (a.data.seriesPart ?? 0) - (b.data.seriesPart ?? 0))
	: [];
---

<Layout title={title} description={description} type="article">
	<article class="container-page pt-14">
		<div class="mx-auto max-w-[70ch]">
			<a href="/blog" class="font-mono text-xs text-muted hover:text-accent">← /blog</a>

			<header class="mt-6 border-b border-line pb-8">
				<div class="flex flex-wrap items-center gap-3 font-mono text-xs text-faint">
					<FormattedDate date={pubDate} />
					<span>·</span>
					<span>{minutes} min read</span>
					{
						updatedDate && (
							<>
								<span>·</span>
								<span>
									updated <FormattedDate date={updatedDate} />
								</span>
							</>
						)
					}
					{draft && <span class="chip">draft</span>}
					{placeholder && <PlaceholderBadge />}
				</div>
				<h1 class="mt-3 text-3xl leading-tight font-semibold tracking-tight text-fg sm:text-4xl">{title}</h1>
				<p class="mt-3 text-lg text-muted">{description}</p>
				{
					tags.length > 0 && (
						<ul class="mt-4 flex flex-wrap gap-1.5">
							{tags.map((t) => (
								<li class="chip">#{t}</li>
							))}
						</ul>
					)
				}
			</header>

			{
				seriesPosts.length > 1 && (
					<nav class="panel mt-8" aria-label={`Series: ${series}`}>
						<div class="panel-head">
							<span>series · {series}</span>
							<span class="tabular">
								{seriesPosts.findIndex((p) => p.id === post.id) + 1}/{seriesPosts.length}
							</span>
						</div>
						<ol class="space-y-1 p-4 font-mono text-sm">
							{seriesPosts.map((p) => (
								<li class="flex gap-3">
									<span class="tabular text-faint">{String(p.data.seriesPart ?? '').padStart(2, '0')}</span>
									{p.id === post.id ? (
										<span class="text-accent" aria-current="page">
											{p.data.title}
										</span>
									) : (
										<a href={`/blog/${p.id}/`} class="text-muted hover:text-fg">
											{p.data.title}
										</a>
									)}
								</li>
							))}
						</ol>
					</nav>
				)
			}

			<div class="prose mt-10">
				<Content components={{ Figure, Decision }} />
			</div>

			<nav class="mt-16 grid gap-4 border-t border-line pt-8 sm:grid-cols-2" aria-label="More posts">
				{
					older ? (
						<a href={`/blog/${older.id}/`} class="panel group p-4 hover:border-accent">
							<span class="label">← older</span>
							<span class="mt-1 block text-sm text-fg group-hover:text-accent">{older.data.title}</span>
						</a>
					) : (
						<span />
					)
				}
				{
					newer && (
						<a href={`/blog/${newer.id}/`} class="panel group p-4 text-right hover:border-accent">
							<span class="label">newer →</span>
							<span class="mt-1 block text-sm text-fg group-hover:text-accent">{newer.data.title}</span>
						</a>
					)
				}
			</nav>
		</div>
	</article>
</Layout>
