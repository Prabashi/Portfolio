---
import PostList from '../../components/PostList.astro';
import Layout from '../../layouts/Layout.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Layout title="Blog" description="Notes on C#, .NET and building systems for capital markets.">
	<div class="container-page pt-14">
		<p class="label">/blog</p>
		<h1 class="mt-2 text-3xl font-semibold tracking-tight text-fg">Writing</h1>
		<p class="mt-3 max-w-2xl text-muted">
			Notes on C#, .NET and the engineering behind trading systems. Subscribe via <a href="/rss.xml" class="link"
				>RSS</a
			>.
		</p>
		{
			tags.length > 0 && (
				<ul class="mt-6 flex flex-wrap gap-1.5">
					{tags.map((t) => (
						<li class="chip">#{t}</li>
					))}
				</ul>
			)
		}
		<div class="mt-8 max-w-3xl">
			<PostList posts={posts} showDescription />
		</div>
	</div>
</Layout>
